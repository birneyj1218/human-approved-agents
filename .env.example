# Copy to .env and fill in. Never commit .env.
# Every value here is a placeholder.

# --- Who may approve -------------------------------------------------------
# Comma-separated user IDs. Discord: right-click your name > Copy User ID
# (needs Developer Mode). Nobody on this list = nothing can be approved.
APPROVER_USER_IDS=cli-owner
# Identity used by the terminal approver (haa run --adapter cli).
CLI_USER_ID=cli-owner

# --- Sending ---------------------------------------------------------------
# false = dry run: approved items are logged as "would send" and never delivered.
SEND_ENABLED=false
# console | file  (file appends to DATA_DIR/outbox.jsonl)
SENDER=console
MAX_SENDS_PER_HOUR=20
MAX_COMMANDS_PER_MINUTE=10

# --- LLM -------------------------------------------------------------------
# fake = offline, deterministic. openai = any OpenAI-compatible server.
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.openai.com/v1
# Local examples: http://localhost:11434/v1 (Ollama), http://localhost:8080/v1 (llama.cpp)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_S=60
MAX_REDRAFTS=2

# --- Discord ---------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- Voice (optional; pip install -e '.[voice]') ---------------------------
VOICE_ENABLED=false
# auto | cuda | cpu | off
VOICE_DEVICE=auto
WHISPER_MODEL=small
# Path to a Piper .onnx voice file you downloaded yourself.
PIPER_VOICE_PATH=

# --- Paths -----------------------------------------------------------------
DATA_DIR=data
PROFILES_DIR=profiles
FIXTURES_DIR=fixtures
